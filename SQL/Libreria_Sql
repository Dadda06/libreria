CREATE DATABASE Libreria;
USE Libreria;

-- TABELLA AUTORI
CREATE TABLE Autori (
    idAutore INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(255),
    cognome VARCHAR(255), 
    data_nascita DATE,
    nazionalita VARCHAR(65)
);

-- TABELLA GENERI
CREATE TABLE Generi (
    idGenere INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(45)
);

-- TABELLA CASA EDITRICE
CREATE TABLE Casa_Editrice (
    idCasa INT PRIMARY KEY, 
    nome VARCHAR(65)
);

-- TABELLA LIBRI
CREATE TABLE Libri (
    idLibro INT(13) PRIMARY KEY,
    titolo VARCHAR(45),
    anno DATE,
    fk_genere INT,
    FOREIGN KEY (fk_genere) REFERENCES Generi(idGenere)
);

-- TABELLA LIBRI_AUTORI
CREATE TABLE Libri_Autori (
    fk_libro INT(13),
    fk_autore INT,
    PRIMARY KEY (fk_libro, fk_autore),
    FOREIGN KEY (fk_libro) REFERENCES Libri(idLibro),
    FOREIGN KEY (fk_autore) REFERENCES Autori(idAutore)
);

-- TABELLA COPIE
CREATE TABLE Copie (
    idCopia INT AUTO_INCREMENT PRIMARY KEY,
    fk_libro INT(13),
    casa_editrice VARCHAR(45),
    numero_copie INT NOT NULL,
    is_disponibile TINYINT(1),
    fk_casa INT,
    FOREIGN KEY (fk_casa) REFERENCES Casa_Editrice(idCasa),
    FOREIGN KEY (fk_libro) REFERENCES Libri(idLibro)
);
Alter TABLE Copie 
drop COLUMN is_disponibile;
Alter TABLE Copie
drop COLUMN casa_editrice;

